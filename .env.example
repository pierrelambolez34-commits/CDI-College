# Adresse de la base PostgreSQL
DATABASE_URL=postgres://cdi:cdi@localhost:5432/cdi

# Base utilisée par les tests automatiques (elle est vidée à chaque test)
TEST_DATABASE_URL=postgres://cdi:cdi@localhost:5432/cdi_test

# Premier compte super-administrateur (créé par « npm run db:superadmin »)
SUPERADMIN_EMAIL=admin@exemple.fr
SUPERADMIN_PASSWORD=change-moi-tout-de-suite

# Adresse publique de l'application (utilisée dans les liens des e-mails)
APP_URL=http://localhost:3000

# Envoi des e-mails. Laisser vide sur ton ordinateur : les e-mails s'affichent dans « E-mails de test ».
# En ligne avec Brevo : SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER et SMTP_PASS donnés par Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expéditeur : elle doit être validée dans Brevo
MAIL_FROM=Passages CDI <no-reply@exemple.fr>
